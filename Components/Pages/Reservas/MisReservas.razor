@page "/reservas"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Cliente")]
@using Microsoft.AspNetCore.Components.Authorization
@using sharpness_sharp.Data.Entities
@using sharpness_sharp.Data.Enums
@using sharpness_sharp.Features.Reservations
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ReservationService ReservationService

<PageTitle>Mis reservas</PageTitle>

<h1 class="text-3xl font-bold">Mis reservas</h1>
<p class="mt-1 text-gray-600">Consulta el estado y el historial de tus solicitudes.</p>

@if (loading)
{
    <p class="mt-6">Cargando reservas...</p>
}
else if (reservations.Count == 0)
{
    <div class="ui-card mt-6">
        <p>Aun no tienes reservas.</p>
    </div>
}
else
{
    <div class="mt-6 flex flex-col gap-4">
        @foreach (var reservation in reservations)
        {
            <article class="ui-card">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div>
                        <h2 class="text-xl font-semibold">@(reservation.TravelDeparture?.TravelPackage?.Name ?? "Viaje")</h2>
                        <p class="text-sm text-gray-600">Codigo: @reservation.Code</p>
                        <p class="text-sm text-gray-600">Salida: @reservation.TravelDeparture?.DepartureDate.ToString("dd/MM/yyyy")</p>
                    </div>
                    <span class="rounded-full bg-gray-100 px-3 py-1 text-sm font-semibold">@reservation.Status</span>
                </div>

                <div class="mt-4 grid gap-2 text-sm md:grid-cols-3">
                    <p>Personas: <strong>@reservation.NumberOfPeople</strong></p>
                    <p>Precio total: <strong>Bs @reservation.TotalPrice.ToString("N2")</strong></p>
                    <p>Solicitada: <strong>@reservation.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></p>
                </div>

                <h3 class="mt-5 font-semibold">Historial</h3>
                @if (reservation.StatusHistory.Count == 0)
                {
                    <p class="mt-2 text-sm text-gray-600">Sin movimientos registrados.</p>
                }
                else
                {
                    <ol class="mt-2 flex flex-col gap-2 border-l-2 border-gray-200 pl-4">
                        @foreach (var history in reservation.StatusHistory.OrderByDescending(item => item.ChangedAt))
                        {
                            <li>
                                <p class="font-medium">@history.PreviousStatus -> @history.NewStatus</p>
                                <p class="text-sm text-gray-600">
                                    @history.ChangedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    @if (history.ChangedByUser is not null)
                                    {
                                        <span> por @(history.ChangedByUser.FirstName + " " + history.ChangedByUser.LastName).Trim()</span>
                                    }
                                </p>
                            </li>
                        }
                    </ol>
                }

                @if (reservation.Status is ReservationStatus.Pendiente or ReservationStatus.Confirmada)
                {
                    <p class="mt-4 text-sm text-gray-600">La cancelacion se habilitara desde el flujo de reserva.</p>
                }
            </article>
        }
    </div>
}

@code {
    private List<Reservation> reservations = [];
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (!string.IsNullOrWhiteSpace(userId))
            reservations = await ReservationService.GetForUserAsync(userId);

        loading = false;
    }
}
